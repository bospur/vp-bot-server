#!/bin/sh
# Pre-commit хук — запускается перед каждым коммитом

set -e  # останавливаемся при первой ошибке

echo "🔍 Форматирование кода (gofmt)..."
gofmt -w .
git add -u  # добавляем отформатированные файлы обратно в коммит

echo "🔍 Проверка кода (go vet)..."
go vet ./...

echo "🔍 Запуск тестов..."
go test ./...

echo "🔍 Сборка проекта (go build)..."
go build ./...

echo "✅ Все проверки пройдены"
