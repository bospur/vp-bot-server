# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=vpbot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vpbot

# Строка подключения для Go приложения
# Формат: postgres://user:password@host:port/dbname?sslmode=disable
# "db" — имя сервиса в docker-compose, Docker сам его резолвит
DATABASE_URL=postgres://vpbot:change_me@db:5432/vpbot?sslmode=disable

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Сервер ───────────────────────────────────────────────────────────────────
PORT=8080
